# --- Portal Credentials ---
PORTAL_URL="https://your-company-portal.com/login"
PORTAL_USERNAME="your-email@company.com"
PORTAL_PASSWORD="your-strong-password"

# --- Selectors (Customizable if defaults don't match your portal) ---
# If left blank, the bot will auto-detect common selectors
USERNAME_SELECTOR=""
PASSWORD_SELECTOR=""
LOGIN_SUBMIT_SELECTOR=""
CHECKIN_SELECTOR=""
CHECKOUT_SELECTOR=""

# --- Telegram Notifications (Optional, but highly recommended) ---
# Create a free bot using @BotFather on Telegram to get your token and chat ID
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# --- Settings ---
# Headless mode: True for server/cloud, False for visual debugging on local PC
HEADLESS="True"
# Random delay in seconds (e.g. 0 to 900 for up to 15 min jitter)
MAX_JITTER_SECONDS="600"
